# Copy this file to .env.local and fill in the values.

# Base URL of the backend API, without a trailing slash.
# Left empty, requests go to this app's own /api routes, which only serve the
# demo pages. Sign in needs a real backend.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8080/api/v1

# Optional. Sent to the backend as the X-Client-Code header when set.
# The backend must allow that header in its CORS settings.
NEXT_PUBLIC_CLIENT_CODE=
